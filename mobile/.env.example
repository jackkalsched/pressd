# Copy to mobile/.env and fill in. EXPO_PUBLIC_* vars are inlined into the JS
# bundle at build time — never put secrets here.

# The Render API base URL (same value as Vercel's VITE_API_URL), no trailing slash
EXPO_PUBLIC_API_URL=

# Google OAuth clients. The web client already exists (same one the site uses);
# create the iOS client in the same Google Cloud project with bundle id com.pressd.app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=459747258455-hpl0q50qjag0e4p170o2rvaj53gcp8nm.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Dev only: a backend-minted JWT to sign in without Google (works in Expo Go).
# Generate with: python -c "from backend.deps import create_access_token; print(create_access_token(1))"
EXPO_PUBLIC_DEV_TOKEN=
