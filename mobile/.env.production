# Config for Release builds (TestFlight / App Store). Expo loads this file when
# NODE_ENV=production, which is what the Xcode "Bundle React Native code and
# images" build phase sets for the Release configuration. Dev keeps using .env.
#
# IMPORTANT: .env is still read as a fallback for any key absent here, so every
# dev-only key must be explicitly blanked below — not just omitted.

# The Render backend, same host the website's VITE_API_URL points at. No
# trailing slash — the shared api client concatenates paths directly.
EXPO_PUBLIC_API_URL=https://pressd-backend.onrender.com

# Blanked on purpose: hides the "Continue with dev token" button, which would
# otherwise ship a signed-in-as-user-1 backdoor to every TestFlight tester.
EXPO_PUBLIC_DEV_TOKEN=

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=459747258455-hpl0q50qjag0e4p170o2rvaj53gcp8nm.apps.googleusercontent.com

# iOS OAuth client for bundle id com.pressd.app. This is what lets the 22
# existing Google users reach their real accounts instead of landing in a new
# empty one — see the Google section of TESTFLIGHT.md.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=459747258455-bbocleh5m3sqhqdo35u7k1cpvq9rlke7.apps.googleusercontent.com
